; Engine configuration file.

config_version=5

[application]

config/name="Oriel"
run/main_scene="res://app/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://app/assets/icon.svg"
boot_splash/bg_color=Color(0.050980393, 0.06666667, 0.09019608, 1)
boot_splash/image="res://app/assets/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
config/use_custom_user_dir=true
config/custom_user_dir_name="Oriel"

[display]

window/size/viewport_width=1500
window/size/viewport_height=900

[editor_plugins]

enabled=PackedStringArray("res://addons/genesis/plugin.cfg")

[rendering]

environment/defaults/default_clear_color=Color(0.050980393, 0.06666667, 0.09019608, 1)
renderer/rendering_method="forward_plus"
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/anisotropic_filtering_level=4
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=96
